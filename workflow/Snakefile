# old `trim_reads.smk`
rule trim_reads:
    input:
        fastq=rules.concat_parts.output.fastq,
    output:
        logfile=f"{OUTDIR}/{{sample}}_trimmed.log",
        trimmed_reads=f"{OUTDIR}/{{sample}}_trimmed.fastq.gz",
    log:
        f"{LOGDIR}/{{sample}}_trim_reads_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_trim_reads.benchmark"
    conda:
        "envs/trimming.yaml"
    params:
        crop=CROPLEN,
        barcodes=BARCODES,
    shell:
        "python workflow/scripts/trim.py "
        "--infile {input.fastq:q} "
        "--logfile {output.logfile:q} "
        "--outfile {output.trimmed_reads:q} "
        "--barcodes {params.barcodes:q} "
        "--crop {params.crop}"


# old `trim_counts.smk`
rule hard_trim_count:
    input:
        log=rules.trim_reads.output.logfile,
    output:
        counts=f"{OUTDIR}/{{sample}}_hard_trim_count.txt",
    log:
        f"{LOGDIR}/{{sample}}_hard_trim_count_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_hard_trim_count.benchmark"
    conda:
        "envs/default.yaml"
    shell:
        "cat {input.log:q} | "
        "awk '{{ if ($0 ~ /short/) print }}' | "
        "wc -l > {output.counts:q}"


rule chimeric_count:
    input:
        fastq=rules.trim_reads.output.trimmed_reads,
    output:
        counts=f"{OUTDIR}/{{sample}}_chimeric_count.txt",
    log:
        f"{LOGDIR}/{{sample}}_chimer_count_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_chimer_count.benchmark"
    conda:
        "envs/default.yaml"
    shell:
        "gzip -dc {input.fastq:q} | "
        "awk '{{ if ($0 ~ /_A/ || $0 ~ /_B/) print $0 }}' | "
        "wc -l > {output.counts:q}"


# old `deduplicate.smk`
rule bin_reads_by_length:
    input:
        fastq=rules.trim_reads.output.trimmed_reads,
    output:
        flag=touch(f"{OUTDIR}/{{sample}}_bin_reads.done"),
    log:
        f"{LOGDIR}/{{sample}}_bin_reads_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_bin_reads.benchmark"
    conda:
        "envs/deduplication.yaml"
    params:
        outdir=f"{OUTDIR}/{{sample}}_read_bins",
    shell:
        "mkdir -p {params.outdir:q}; "
        "python workflow/scripts/bin_reads.py "
        "--infile {input.fastq:q} "
        "--outdir {params.outdir:q}"


rule cluster_reads:
    input:
        flag=rules.bin_reads_by_length.output.flag,
    output:
        flag=touch(f"{OUTDIR}/{{sample}}_cluster_reads.done"),
    log:
        f"{LOGDIR}/{{sample}}_cluster_reads_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_cluster_reads.benchmark"
    conda:
        "envs/deduplication.yaml"
    params:
        similarity_threshold=SIMILARITY,
        indir=f"{OUTDIR}/{{sample}}_read_bins",
        outdir=f"{OUTDIR}/{{sample}}_read_clusters",
    shell:
        "mkdir -p {params.outdir:q}; "
        "python workflow/scripts/cluster_reads.py "
        "--threshold {params.similarity_threshold} "
        "--indir {params.indir:q} "
        "--outdir {params.outdir:q}; "
        "rm -rf {params.indir:q}; "
        "rm {input:q}"


rule blat_clustered_reads:
    input:
        flag=rules.cluster_reads.output.flag,
    output:
        flag=touch(f"{OUTDIR}/{{sample}}_blat.done"),
    log:
        f"{LOGDIR}/{{sample}}_blat_reads_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_blat.benchmark"
    conda:
        "envs/deduplication.yaml"
    threads: 32
    params:
        rc=f"{OUTDIR}/{{sample}}_read_clusters/",
        o=f"{OUTDIR}/{{sample}}_psl_files/",
        fast_map_flag=lambda wildcards: "--fast_map" if FASTMAP else "",
    shell:
        "mkdir -p {params.o:q}; "
        "python workflow/scripts/run_blat.py "
        "--outdir {params.o:q} "
        "--threads {threads} "
        "--read_clusters {params.rc:q} "
        "{params.fast_map_flag}; "
        "rm -rf {params.rc:q}; "
        "rm {input:q}"


rule find_duplicates:
    input:
        flag=rules.blat_clustered_reads.output.flag,
    output:
        flag=touch(f"{OUTDIR}/{{sample}}_find_duplcates.done"),
    log:
        f"{LOGDIR}/{{sample}}_find_dups_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_find_dups.benchmark"
    conda:
        "envs/deduplication.yaml"
    threads: 8
    params:
        similarity_threshold=SIMILARITY,
        pls_dir=f"{OUTDIR}/{{sample}}_psl_files/",
        outdir=f"{OUTDIR}/{{sample}}_duplicate_txts/",
    shell:
        "python workflow/scripts/find_duplicates.py "
        "-p {params.pls_dir:q} "
        "-o {params.outdir:q} "
        "-s {params.similarity_threshold} "
        "-t {threads}; "
        "rm -rf {params.pls_dir:q}; "
        "rm {input:q}"


rule merge_duplicates_lists:
    input:
        flag=rules.find_duplicates.output.flag,
    output:
        dups=f"{OUTDIR}/{{sample}}_duplicates.txt",
    log:
        f"{LOGDIR}/{{sample}}_merge_dup_lists_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_merge_dups_lists.benchmark"
    conda:
        "envs/default.yaml"
    params:
        indir=f"{OUTDIR}/{{sample}}_duplicate_txts",
    shell:
        "cat {params.indir:q}/* > {output.dups:q}; rm -rf {params.indir:q}"


rule deduplicate:
    input:
        reads=rules.trim_reads.output.trimmed_reads,
        duplicates_list=rules.merge_duplicates_lists.output.dups,
    output:
        reads=f"{OUTDIR}/{{sample}}_dedup.fastq.gz",
        dupes=f"{OUTDIR}/{{sample}}_dup_reads.fastq.gz",
    log:
        f"{LOGDIR}/{{sample}}_dedup_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_dedup.benchmark"
    conda:
        "envs/deduplication.yaml"
    shell:
        "python workflow/scripts/deduplicate.py "
        "--reads {input.reads:q} "
        "--duplicates {input.duplicates_list:q} "
        "--out_reads {output.reads:q} "
        "--out_dupes {output.dupes:q}"


