# old `on_target_stats.smk`
rule viruses_alignment_stats:
    input:
        sam=rules.align_to_viruses_for_stats_no_secondary.output.sam,
    output:
        idx=temp(f"{OUTDIR}/{{sample}}_all_viruses_samtools.idxstats"),
    log:
        f"{LOGDIR}/{{sample}}_stat_align_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_stat_align.benchmark"
    conda:
        "envs/alignment.yaml"
    threads: 32
    params:
        cutoff=CUTOFF,
        bam=f"{OUTDIR}/{{sample}}_stats_viruses_sorted.bam",
        sftbam=f"{OUTDIR}/{{sample}}_stats_viruses_sorted_sftclp.bam",
    shell:
        "samtools view -h -F 2048 -Sb {input.sam:q} | "
        "samtools sort -@ {threads} -o {params.bam:q}; "
        "samtools index -@ {threads} {params.bam:q}; "
        "python workflow/scripts/sftclipper.py "
        "--cutoff {params.cutoff} "
        "--bam {params.bam:q} "
        "--outfile {params.sftbam:q}; "
        "samtools index -@ {threads} {params.sftbam:q}; "
        "samtools idxstats {params.sftbam:q} > {output.idx:q}; "
        "rm {params.bam:q} {params.bam:q}.bai; "
        "rm {params.sftbam:q} {params.sftbam:q}.bai"


