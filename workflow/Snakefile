# old `find_viral_targets.smk`
rule mpileup:
    input:
        bam=rules.viruses_sam_to_bam.output.bam,
    output:
        pileup=f"{OUTDIR}/{{sample}}.mpileup",
    conda:
        "envs/alignment.yaml"
    threads: 10
    benchmark:
        f"{BENCHDIR}/{{sample}}_mpileup.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_mpileup_snakemake.log",
    shell:
        "samtools mpileup --output-QNAME {input.bam} | "
        "awk '{{print $1\"\t\"$4}}' - > {output.pileup}"


rule find_viral_targets:
    input:
        pileup=rules.mpileup.output.pileup,
        all_viruses_bed=f"{OUTDIR}/all_viral_targets.bed",
        strain_db=STRAIN_DB,
    output:
        bed=temp(f"{OUTDIR}/{{sample}}_viral_targets.bed"),
        logfile=f"{OUTDIR}/{{sample}}_viral_targets.log",
        selected_log=f"{OUTDIR}/{{sample}}_selected_viral_targets.log",
    params:
        email=EMAIL,
    conda:
        "envs/alignment.yaml"
    benchmark:
        f"{BENCHDIR}/{{sample}}_viral_targets.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_viral_targets_snakemake.log",
    shell:
        "python workflow/scripts/find_viral_targets.py "
        "--mpileup {input.pileup} "
        "--bed {input.all_viruses_bed} "
        "--strains {input.strain_db} "
        "--logfile {output.logfile} "
        "--outfile {output.bed}; "
        "python workflow/scripts/add_viral_segments.py "
        "--infile {output.logfile} "
        "--email {params.email}; "
        "awk -F'\t' '{{ if($3 > 80.0) print}}' {output.logfile} "
        "> {output.selected_log}"


checkpoint get_viral_genomes:
    input:
        fasta=VIRUSES,
        bed=rules.find_viral_targets.output.bed,
    output:
        f"{OUTDIR}/{{sample}}_viral_target_genomes.fasta",
    params:
        succeed=f"{OUTDIR}/{{sample}}_VIRAL_TARGETS_FOUND",
        fail=f"{OUTDIR}/{{sample}}_NO_VIRAL_TARGETS",
    conda:
        "envs/alignment.yaml"
    benchmark:
        f"{BENCHDIR}/{{sample}}_get_viral_genomes.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_get_viral_genomes_snakemake.log",
    shell:
        "bedtools getfasta -fi {input.fasta} -bed {input.bed} -fo {output}; "
        "if grep -q . {output}; then touch {params.succeed}; else touch {params.fail}; fi"


# old `add_sample_info.smk`
rule add_sample_info:
    input:
        rules.pre_dedup_read_lengths.output.rl,
        rules.post_dedup_read_lengths.output.rl,
        rules.reads_per_strain.output.tsv,
        rules.filter_reads_per_strain.output.tsv,
        rules.find_viral_targets.output.logfile,
        rules.find_viral_targets.output.selected_log,
    output:
        touch(f"{OUTDIR}/{{sample}}_add_sample_info.done"),
    params:
        run_id=RUNID,
        sample_id="{sample}",
    conda:
        "envs/default.yaml"
    benchmark:
        f"{BENCHDIR}/{{sample}}_add_sample_info.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_sample_info_snakemake.log",
    shell:
        "python workflow/scripts/add_run_info.py "
        "--sample_id {params.sample_id} "
        "--run_id {params.run_id} "
        "--infiles {input}"


## HAPLOTYPE GENERATION ########################################################
rule split_viral_genomes:
    input:
        fasta=f"{OUTDIR}/{{sample}}_viral_target_genomes.fasta",
    output:
        flag=touch(f"{OUTDIR}/{{sample}}_viral_refs.done")
    params:
        outdir=f"{OUTDIR}/{{sample}}_viral_refs/"
    conda:
        "envs/alignment.yaml"
    benchmark:
        f"{BENCHDIR}/{{sample}}_split_viral_genomes.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_split_viral_genomes_snakemake.log"
    shell:
        "bash workflow/scripts/split_target_viruses.sh {input.fasta} {params.outdir}"


rule align_to_target_virus:
    input:
        flag=rules.split_viral_genomes.output.flag,
        reads=rules.non_host_reads.output.fastq,
    output:
        flag=touch(f"{OUTDIR}/{{sample}}_align_to_targets.done"),
    params:
        indir=f"{OUTDIR}/{{sample}}_viral_refs/",
        outdir=f"{OUTDIR}/{{sample}}_target_aligned/",
        sample="{sample}",
    conda:
        "envs/alignment.yaml"
    threads: 32
    benchmark:
        f"{BENCHDIR}/{{sample}}_align_to_targets.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_align_to_targets_snakemake.log"
    shell:
        "bash workflow/scripts/align_to_targets.sh "
        "{params.outdir} "
        "{params.indir} "
        "{params.sample} "
        "{input.reads} "
        "{threads}"


rule run_rvhaplo:
    input:
        flag=rules.align_to_target_virus.output.flag,
    output:
        flag=touch(f"{OUTDIR}/{{sample}}_rvhaplo.done"),
    params:
        sample="{sample}",
        vir_indir=f"{OUTDIR}/{{sample}}_viral_refs/",
        sam_indir=f"{OUTDIR}/{{sample}}_target_aligned/",
        outdir=f"{OUTDIR}/{{sample}}_rvhaplo_out/"
    conda:
        "envs/rvhaplo.yaml"
    threads: 32
    benchmark:
        f"{BENCHDIR}/{{sample}}_run_rvhaplo.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_run_rvhaplo_snakemake.log"
    shell:
        "bash workflow/scripts/run_rvhaplo.sh "
        "{params.outdir} "
        "{params.vir_indir} "
        "{params.sam_indir} "
        "{params.sample} "
        "{threads}"


rule parse_rvhaplo_out:
    input:
        flag=rules.run_rvhaplo.output.flag,
        strain_db=STRAIN_DB,
    output:
        tsv=f"{OUTDIR}/{{sample}}_rvhaplo_results_table.tsv"
    params:
        indir=f"{OUTDIR}/{{sample}}_rvhaplo_out/"
    conda:
        "envs/rvhaplo.yaml"
    benchmark:
        f"{BENCHDIR}/{{sample}}_parse_rvhaplo.benchmark"
    log:
        f"{LOGDIR}/{{sample}}_parse_rvhaplo_snakemake.log"
    shell:
        "python workflow/scripts/parse_rvhaplo.py "
        "--indir {params.indir} "
        "--strains {input.strain_db} "
        "--outfile {output}"


onsuccess:
    shell(f"bash workflow/scripts/log_cleanup.sh {LOGDIR}")
