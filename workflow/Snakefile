        "--outfile {output.bam:q}; "
        "samtools index -@ {threads} {output.bam:q}; "
        "samtools view -h -F 2048 -b {output.bam:q} | "
        "samtools idxstats - > {output.idx:q}; "
        "rm {params.tmp_bam:q} {params.tmp_bam:q}.bai"


