rule on_target_stats:
    input:
        viral_stats=rules.merge_viral_alignment_stats.output.tsv,
        host_stats=rules.host_removal_stats.output.tsv,
    output:
        tsv=f"{OUTDIR}/on_target_stats.tsv",
    conda:
        "envs/alignment.yaml"
    benchmark:
        f"{BENCHDIR}/on_target_stats.benchmark"
    log:
        f"{LOGDIR}/on_target_stats_snakemake.log",
    shell:
        "python workflow/scripts/merge_stats.py "
        "--host_stats {input.host_stats} "
        "--viral_stats {input.viral_stats} "
        "--outfile {output.tsv}"


