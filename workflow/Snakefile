# old `host_removal.smk`
rule align_reads_to_host:
    input:
        host=HOST_FILE,
        samples=rules.deduplicate.output.reads,
    output:
        sam=temp(f"{OUTDIR}/{{sample}}_host.sam"),
    log:
        f"{LOGDIR}/{{sample}}_ato_host_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_ato_host.benchmark"
    conda:
        "envs/alignment.yaml"
    threads: 32
    shell:
        "minimap2 --secondary=no "
        "-t {threads} "
        "-o {output.sam:q} "
        "-a {input.host:q} {input.samples:q}"


rule host_sam_to_bam:
    input:
        sam=rules.align_reads_to_host.output.sam,
    output:
        bam=temp(f"{OUTDIR}/{{sample}}_host_sorted.bam"),
    log:
        f"{LOGDIR}/{{sample}}_host_sam2bam_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_host_sam2bam.benchmark"
    conda:
        "envs/alignment.yaml"
    threads: 32
    shell:
        "samtools view -Sb {input.sam:q} | samtools sort -@ {threads} -o {output.bam:q}"


rule remove_host_dna:
    input:
        bam=rules.host_sam_to_bam.output.bam,
    output:
        idx=temp(f"{OUTDIR}/{{sample}}_remove_host_samtools.idxstats"),
        bam=temp(f"{OUTDIR}/{{sample}}_host_removed_sorted.bam"),
    log:
        f"{LOGDIR}/{{sample}}_host_removal_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_host_removal.benchmark"
    conda:
        "envs/alignment.yaml"
    threads: 10
    shell:
        "samtools index {input.bam:q} && "
        "samtools view -h -F 2048 -b {input.bam:q} | "
        "samtools idxstats - > {output.idx:q}; "
        "samtools view -h -f 4 -b {input.bam:q} -o {output.bam:q}; "
        "rm {input.bam:q}.bai"


rule non_host_reads:
    input:
        bam=rules.remove_host_dna.output.bam,
    output:
        fastq=f"{OUTDIR}/{{sample}}_non_host.fastq.gz",
    log:
        f"{LOGDIR}/{{sample}}_non_host_reads_snakemake.log",
    benchmark:
        f"{BENCHDIR}/{{sample}}_non_host_reads.benchmark"
    conda:
        "envs/alignment.yaml"
    threads: 4
    shell:
        "samtools fastq {input.bam:q} | bgzip -@ {threads} -c > {output.fastq:q}"


